# Godot editor import cache (never commit). Do not ignore godot/plugin-project sources.
.godot/
**/.godot/

# Node sidecar
node_modules/
/bridge/dist/
**/__pycache__/
*.pyc

# Local Godot binary / template cache (never commit zip/tpz/exe)
.godot-cache/
/Godot_v*.zip
/Godot_v*.tpz
/Godot_v*.exe

# MCP candidate clone bodies (R1-WP2). Commit LICENSE + PIN.json only.
third_party/mcp-staging/**
!third_party/mcp-staging/README.md
!third_party/mcp-staging/*/
!third_party/mcp-staging/*/LICENSE
!third_party/mcp-staging/*/PIN.json

# Agent secrets / local session. Commit policy.example.toml only — never live tokens.
.hh-agent/policy.toml
.hh-agent/secrets/
.hh-agent/**/*.token
.hh-agent/session.json
.env
.env.*

# R1-WP3 MCP bake-off disposable copies (never vendor into plugin-project).
