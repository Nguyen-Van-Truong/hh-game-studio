# Godot editor import cache (never commit). Do not ignore godot/plugin-project sources.
.godot/
**/.godot/

# Sidecar import settings next to game assets are committed. Screenshot
# evidence/review .import files are editor noise only.
godot/dogfood/superfighters/docs/evidence/**/*.import
godot/dogfood/superfighters/docs/review/**/*.import

# Node sidecar / host
node_modules/
/bridge/dist/
/host/dist/
**/__pycache__/
*.pyc

# Local Godot binary / template cache (never commit zip/tpz/exe)
.godot-cache/
/Godot_v*.zip
/Godot_v*.tpz
/Godot_v*.exe

# MCP candidate clone bodies (R1-WP2). Commit LICENSE + PIN.json only.
third_party/mcp-staging/**
!third_party/mcp-staging/README.md
!third_party/mcp-staging/*/
!third_party/mcp-staging/*/LICENSE
!third_party/mcp-staging/*/PIN.json

# Local agent worktrees / critic isos / logs (Cargo target equivalent).
# Keep the pin + example policy; never commit live tokens or iso copies.
.hh-agent/**
!.hh-agent/capability-lock.json
!.hh-agent/policy.example.toml
.hh-agent/policy.toml
.hh-agent/secrets/
.hh-agent/**/*.token
.hh-agent/session.json
godot/dogfood/superfighters/.hh-agent/
.env
.env.*

