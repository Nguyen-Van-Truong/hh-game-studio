# Frozen HH3D source manifests hash the same bytes on Windows and CI.
.gitattributes text eol=lf
.gitignore text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.gd text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.cfg text eol=lf
*.blend binary
*.snapshot -text
studio/evidence/** -text
zdoc/reviews/20260910-r6/worker-output/** -text
# Hash-bound GT-02 run packages and their historical records retain exact bytes.
# Source files above still use LF; never normalize a captured proof on checkout.
zdoc/reviews/*-gt02-s[0-9]*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
zdoc/reviews/*-gt02-s[0-9]*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep actual GT-03 engine streams and frozen snapshots byte-exact as captured.
zdoc/reviews/*-gt03-s[0-9]*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve native engine progress spacing and the crash log's final blank line.
zdoc/reviews/*-gt03-s47-editor-*/*-engine.log whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
zdoc/reviews/*-gt03-s48-editor-*/*-engine.log whitespace=-blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
zdoc/reviews/*-gt03-s48-linux-*/*/engine-stdout.txt whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
# S49 raw engine streams and failed test progress retain their observed bytes.
