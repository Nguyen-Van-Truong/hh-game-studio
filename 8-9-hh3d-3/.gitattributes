# Frozen HH3D source manifests hash the same bytes on Windows and CI.
.gitattributes text eol=lf
.gitignore text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.gd text eol=lf
*.uid text eol=lf
*.import text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.cfg text eol=lf
*.blend binary
# Native-generated pinned Blender fixtures were frozen as CRLF bytes.
studio/blender-addon/exporter.lock.json -text
studio/tests/blender/fixtures/box-export-baseline.json -text
*.snapshot -text
studio/evidence/** -text
zdoc/reviews/20260910-r6/worker-output/** -text
# Hash-bound GT-02 run packages and their historical records retain exact bytes.
# Source files above still use LF; never normalize a captured proof on checkout.
zdoc/reviews/*-gt02-s[0-9]*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
zdoc/reviews/*-gt02-s[0-9]*.md -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Keep actual GT-03 engine streams and frozen snapshots byte-exact as captured.
zdoc/reviews/*-gt03-s[0-9]*/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# GT04 native capture/source snapshots retain the exact bytes hashed by its runner.
