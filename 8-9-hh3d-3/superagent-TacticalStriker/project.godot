; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SuperAgent - Tactical Striker (3.5-Head)"
config/description="SuperAgent Tactical Striker (3.5-Head S-Curve Spine & 7 Live Expressions)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SFDataRegistry="*res://game/core/sf_data_registry.gd"
AudioManager="*res://game/core/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="fractional"

[physics]

common/physics_ticks_per_second=60
2d/default_gravity=980.0

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.08, 0.08, 0.1, 1)
