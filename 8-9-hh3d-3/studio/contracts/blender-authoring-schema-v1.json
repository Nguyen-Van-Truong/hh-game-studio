            "channel": {
              "enum": [
                "location",
                "rotation_euler",
                "scale"
              ]
            },
            "frame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "values": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "interpolation": {
              "enum": [
                "CONSTANT",
                "LINEAR"
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "channel": {
                    "const": "rotation_euler"
                  }
                }
              },
              "then": {
                "properties": {
                  "values": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": -6.283185307179586,
                      "maximum": 6.283185307179586
                    }
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "channel": {
                    "const": "scale"
                  }
                }
              },
              "then": {
                "properties": {
                  "values": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number",
                      "minimum": 0.001,
                      "maximum": 1000
                    }
                  }
                }
              }
            }
          ]
        }
      }
