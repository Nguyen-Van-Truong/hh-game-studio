{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hh:godot-authoring-catalog:1",
  "title": "CR-GODOT-AUTHORING-01 catalog schema v1",
  "description": "Schema for the x-candidate catalog instance below, not a replacement Request envelope. Class/property descriptions are hand-authored candidates, NOT extracted or verified against ClassDB. Numeric limits are candidate policy caps, not native property ranges. No runtime capability is enabled.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "profile",
    "change_request",
    "status",
    "native_evidence",
    "runtime_enabled",
    "script_enabled",
    "required_script_gates",
    "operations",
    "resource_bases",
    "classes"
  ],
  "properties": {
    "catalog_version": {
      "const": 1
    },
    "profile": {
      "const": "hh-godot-gameplay-source-1"
    },
    "change_request": {
      "const": "CR-GODOT-AUTHORING-01"
    },
    "status": {
      "const": "CANDIDATE_ONLY"
    },
    "native_evidence": {
      "const": "UNVERIFIED"
    },
    "runtime_enabled": {
      "const": false
    },
    "script_enabled": {
      "const": false
    },
    "required_script_gates": {
      "const": [
        "AUTH-01",
        "AUTH-02",
        "AUTH-03",
        "AUTH-04",
        "AUTH-05"
      ]
    },
    "operations": {
      "const": [
        "scene.node.create",
        "scene.node.update"
      ]
    },
    "resource_bases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Za-z0-9_]*$"
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class_spec"
      }
    }
  },
  "$defs": {
    "property_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "writable"
      ],
      "properties": {
        "type": {
          "enum": [
            "bool",
            "int",
            "float",
            "string",
            "vector2",
            "vector3",
            "enum",
            "resource"
          ]
        },
        "writable": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer"
          }
        },
        "resource_base": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "int",
                  "float",
                  "vector2",
                  "vector3"
                ]
              }
            }
          },
          "then": {
            "required": [
              "minimum",
              "maximum"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "minimum"
                  ]
                },
                {
                  "required": [
                    "maximum"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "enum"
              }
            }
          },
          "then": {
            "required": [
              "values"
            ]
          },
          "else": {
            "not": {
              "required": [
                "values"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "resource"
              }
            }
          },
          "then": {
            "required": [
              "resource_base"
            ]
          },
          "else": {
            "not": {
              "required": [
                "resource_base"
              ]
            }
          }
        }
      ]
    },
    "class_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_name",
        "property_base",
        "native_base",
        "domain",
        "kind",
        "instantiable",
        "properties"
      ],
      "properties": {
        "class_name": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]*$"
        },
        "property_base": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_base": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9_]*$"
        },
        "domain": {
          "enum": [
            "2d",
            "3d",
            "ui",
            "audio",
            "animation",
            "input"
          ]
        },
        "kind": {
          "enum": [
            "node",
            "singleton"
          ]
        },
        "instantiable": {
          "type": "boolean"
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/property_spec"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "singleton"
              }
            }
          },
          "then": {
            "properties": {
              "instantiable": {
                "const": false
              },
              "property_base": {
                "type": "null"
              },
              "properties": {
                "maxProperties": 0
              }
            }
          },
          "else": {
            "properties": {
              "instantiable": {
                "const": true
              }
            }
          }
        }
      ]
    }
  },
