{
  "name": "superagent-2d-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/write-release-manifest.mjs",
    "preview": "vite preview",
