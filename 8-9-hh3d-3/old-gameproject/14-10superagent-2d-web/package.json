    "verify:dist": "node scripts/verify-dist.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "tsx": "4.20.6"
  }
}
