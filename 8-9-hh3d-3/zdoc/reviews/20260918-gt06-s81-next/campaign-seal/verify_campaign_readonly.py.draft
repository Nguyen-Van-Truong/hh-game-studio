"""UNEXECUTED DRAFT: join existing GT06 validators after terminal measurement.

No engines/tests/resume, artifact mutation, sealing or acceptance. The operator
must collect terminal scheduler status independently with campaign_task.ps1.
Use the exact pinned Python console binary used by the campaign, with -B.
"""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
CAMPAIGN = 'gt06-s81-campaign-01'
SOURCE_REVISION_EXPECTED = 'b3862a10'
SOURCE = 'e010180a1bf85b7f565e9aa39734f8551caf170a85b36c50598be556b723ce7f'
PROFILE = '0cd5b53055853b592d4376a6b8a89d69c70ea5facc40dfc25ebd6fcd6dbf4d85'
TOOLCHAIN = '28bdce555e9a44ef68193723d512feda02c42a417ceb78faf0b29f52d095dca9'


def need(value, code):
    if not value:
        raise ValueError(code)


def sha(raw):
    return hashlib.sha256(raw).hexdigest()


def same_json(left, right):
    # Python equality aliases false/0 and 0.0/0; serialized JSON keeps their types.
    def encoded(value):
        return json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False)
    return encoded(left) == encoded(right)


def strict(raw):
    def pairs(items):
        result = {}
        for key, value in items:
            need(key not in result, 'DUPLICATE_JSON_KEY')
            result[key] = value
        return result

    def constant(value):
        raise ValueError('NONFINITE_JSON')

    return json.loads(raw, object_pairs_hook=pairs, parse_constant=constant)


def read(path, cap=64 * 1024 * 1024):
    # Preflight must stay independent of benchmark imports. It stops immediately
    # if terminal artifacts are absent; it never walks a running raw tree.
    for component in (path, *path.parents):
        info = component.lstat()
        need(not component.is_symlink() and not getattr(info, 'st_file_attributes', 0) & 0x400,
             'REPARSE_PATH')
    info = path.stat()
    need(path.is_file() and info.st_nlink == 1 and 0 <= info.st_size <= cap, 'FILE_SHAPE')
    raw = path.read_bytes()
    need(len(raw) == info.st_size, 'FILE_CHANGED')
    return raw


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--product-root', type=Path, required=True)
    parser.add_argument('--scheduler-status', type=Path, required=True)
    parser.add_argument('--source-checkpoint', type=Path, required=True)
    parser.add_argument('--launch-number', type=int, default=1)
    args = parser.parse_args()
    product = args.product_root.absolute()
    studio = product / 'studio'
    root = studio / '.local/reviews' / CAMPAIGN
    need(1 <= args.launch_number <= 99, 'LAUNCH_NUMBER')
    suffix = '' if args.launch_number == 1 else f'-launch-{args.launch_number:02d}'
    supervisor = studio / '.local/reviews' / (CAMPAIGN + '-supervisor' + suffix)
    terminal_raw = read(args.scheduler_status.absolute(), 1024 * 1024)
    terminal = strict(terminal_raw)
    returned = strict(read(supervisor / 'return.json', 8192))
    need(terminal.get('schema') == 'HH-GT06-TASK-STATUS-1'
         and terminal.get('campaign_id') == CAMPAIGN and terminal.get('mode') == 'campaign'
         and terminal.get('launch_number') == args.launch_number
         and terminal.get('task_path') == '\\HHStudio.GT06.' + CAMPAIGN + suffix
         and terminal.get('state') == 3 and terminal.get('instances') == []
         and terminal.get('last_task_result') == 0, 'TERMINAL_SCHEDULER_SUCCESS_REQUIRED')
    need(Path(terminal['output_directory']).absolute() == supervisor, 'SUPERVISOR_PATH')
    need(returned.get('returned_exit_code') == 0
         and returned.get('launch_number', 1) == args.launch_number
         and returned.get('actual_process_exit_not_yet_observed') is True
         and returned.get('scheduler_result_still_required') is True,
         'SUPERVISOR_RETURN_BINDING')
    need(not (supervisor / 'failure.json').exists(), 'SUPERVISOR_FAILURE')
    # Read no campaign dataset or runtime tree until terminal scheduler/return.
    names = ('campaign.json', 'campaign-capture.json', 'dataset.json', 'summary.json',
             'benchmark-profile.json')
    raw = {name: read(root / name) for name in names}
    frozen, captured, supplied_dataset, supplied_summary = (strict(raw[name]) for name in names[:4])
    need(captured.get('completed') is True and captured.get('formal_acceptance') is False,
         'COMPLETE_CAPTURE_REQUIRED')
    expected_sources = strict(read(Path(__file__).parent / 'source-files.expected.json'))
    checkpoint_raw = read(args.source_checkpoint.absolute())
    checkpoint = strict(checkpoint_raw)
    need(checkpoint.get('revision') == SOURCE_REVISION_EXPECTED and checkpoint.get('exact_git_bytes') is True
         and checkpoint.get('source_count') == 51 and checkpoint.get('source_closure_sha256') == SOURCE
         and checkpoint.get('source_files') == expected_sources
         and checkpoint.get('benchmark_profile_sha256') == PROFILE, 'NAMED_COMMIT_CHECKPOINT_REQUIRED')

    # Existing modules are imported only after the terminal preflight. These
    # calls read artifacts; never call run_campaign/main/prepare/BenchmarkProcess.
    sys.path.insert(0, str(product))
    from studio.tests.replay import run_benchmark_campaign as campaign
    from studio.tests.replay.benchmark_assembly import assemble_dataset, assemble_run, read_artifact
    from studio.tests.replay.benchmark_readiness import validate_startup_readiness

    campaign.load_fixture()
    sources = campaign.source_files()
    need(sha(raw['benchmark-profile.json']) == PROFILE == campaign.profile.PROFILE_SHA256,
         'EXACT_PROFILE_ARTIFACT')
    supplied_dataset = campaign.profile.parse_dataset(raw['dataset.json'])
    need(frozen['campaign_id'] == CAMPAIGN and frozen['source_files'] == sources == expected_sources
         and len(sources) == 51 and campaign.closure(sources) == SOURCE
         and frozen['source_closure_sha256'] == SOURCE
         and frozen['profile_sha256'] == PROFILE == campaign.profile.PROFILE_SHA256
         and frozen['toolchain_sha256'] == TOOLCHAIN
         and frozen['run_count'] == 10 and frozen['batches_per_run'] == 35,
         'EXACT_CAMPAIGN_SOURCE_PROFILE')
    need(sha(read(Path(sys.executable), 256 * 1024 * 1024)) == frozen['python_executable_sha256'],
         'USE_CAMPAIGN_PINNED_PYTHON')
    for name, digest in sources.items():
        need(sha(read(root / 'source/studio' / name)) == digest, 'FROZEN_CAMPAIGN_SOURCE')
    campaign.require_campaign_running(root)  # Read-only fixed 10x3 Stop slots.
    rows = captured['runs']
    need(type(rows) is list and [row['index'] for row in rows] == list(range(10)), 'TEN_ORDERED_RUNS')
    need(same_json(captured, {'schema_id': 'hh-studio.benchmark-campaign-capture', 'schema_version': '1.0.0',
         'campaign_id': CAMPAIGN, 'completed': True, 'formal_acceptance': False,
         'source_closure_sha256': SOURCE, 'profile_sha256': PROFILE,
         'campaign_sha256': sha(raw['campaign.json']), 'runs': rows,
         'measurement_acceptance': 'REQUIRES_STRICT_ASSEMBLY_AND_REVIEW'}), 'CAMPAIGN_CAPTURE_BINDING')
    bound_runs, identities, unselected = [], set(), []
    for index, row in enumerate(rows):
        match = re.fullmatch(r'run-([0-9]{2})-attempt-([0-9]{2})/run-capture\.json', row['capture']['file'])
        need(match is not None and int(match[1]) == index and 1 <= int(match[2]) <= 3, 'RUN_SLOT')
        attempt = int(match[2])
        run_root = root / row['capture']['file'].rsplit('/', 1)[0]
        run_capture = read_artifact(root, row['capture']).value
        need(row['run_id'] == run_capture['run_id'], 'RUN_ID')
        context = strict(read(run_root / 'context.json'))
        need(context['source_files'] == sources
             and strict(read(run_root / 'source-files.json')) == sources, 'EXACT_RUN_DEPENDENCY_SET')
        campaign.verify_run_capture(run_root, run_capture, SOURCE, campaign_id=CAMPAIGN,
                                    index=index, attempt=attempt, campaign_sha256=sha(raw['campaign.json']))
        native_index = strict(read(run_root / 'project/benchmark/out/index.json'))
        first_batch = strict(read(run_root / 'project/benchmark/out/batch-00.json'))
        first_ready = strict(read(run_root / 'project/benchmark/out/ready-00.json'))
        snapshot = strict(read(run_root / 'editor-snapshot.json'))
        need(native_index.get('schema_version') == '1.3.0', 'S81_NATIVE_INDEX_REQUIRED')
        validate_startup_readiness(native_index.get('startup_readiness'), binding=native_index['input'],
            pid=run_capture['processes']['editor']['pid'], source_files=native_index['source_files'],
            baseline_revision=native_index['baseline_revision'], scene_file_sha256=snapshot[campaign.MUTABLE_SCENE],
            first_batch_started_mono_us=first_batch['started_mono_us'],
            first_cycle_root_before=first_batch['cycles'][0]['root_before'],
            run_started_mono_us=native_index['started_mono_us'],
            first_ready_mono_us=first_ready['issued_mono_us'], first_ready_frame=first_ready['process_frame'])
        for process in run_capture['processes'].values():
            identity = (process['pid'], process['process_start'])
            need(identity not in identities, 'FRESH_PROCESS_PAIR_REQUIRED')
            identities.add(identity)
        for other_attempt in range(1, 4):
            other = root / f'run-{index:02d}-attempt-{other_attempt:02d}'
            if other != run_root and other.exists():
                need(not (other / 'run-capture.json').exists(), 'DUPLICATE_COMPLETED_ATTEMPT')
                unselected.append({'path': other.relative_to(root).as_posix(),
                    'measurement_eligible': False, 'forensic_inventory_and_exit_review': 'REQUIRED'})
        bound = assemble_run(run_root, strict(read(run_root / 'assembly-manifest.json')))
        need(same_json(bound.value['run'], strict(read(run_root / 'assembled-run.json'))),
             'ASSEMBLED_RUN_DRIFT')
        bound_runs.append(bound)
    need(len(identities) == 20, 'TWENTY_FRESH_IDENTITIES')
    provenance = {'source_closure_sha256': SOURCE, 'toolchain_sha256': TOOLCHAIN,
        'workstation_profile_sha256': sha(campaign.encoded(frozen['workstation'])),
        'driver_sha256': sources['tests/replay/run_benchmark_campaign.py'],
        'capture_manifest_sha256': sha(raw['campaign-capture.json'])}
    rebuilt = assemble_dataset(provenance, bound_runs)
    summary = campaign.profile.summarize_dataset(rebuilt)
    need(same_json(rebuilt, supplied_dataset) and same_json(summary, supplied_summary),
         'FINAL_PRODUCER_OUTPUT_DRIFT')
    need(summary['status'] == 'PASS', 'MEASUREMENT_PROFILE_NOT_PASS')
    result = {'schema': 'HH-GT06-S81-CAMPAIGN-READONLY-DRAFT-1',
        'campaign_id': CAMPAIGN, 'verified_campaign_artifacts': True,
        'source_revision_expected': SOURCE_REVISION_EXPECTED,
        'source_closure_sha256': SOURCE, 'profile_sha256': PROFILE,
        'artifact_sha256': {name: sha(value) for name, value in raw.items()},
        'scheduler_status_sha256': sha(terminal_raw), 'launch_number': args.launch_number,
        'source_checkpoint_sha256': sha(checkpoint_raw), 'native_index_schema_version': '1.3.0',
        'startup_readiness_verified_runs': len(bound_runs),
        'selected_run_ids': [row['run_id'] for row in rows],
        'unselected_attempts': unselected, 'measurement_status': summary['status'],
        'final_candidate_sealed': False, 'formal_acceptance': False,
        'remaining': ['all supervisor launch records and XML bindings',
            'inherited functional/source/review/raw dependency closure',
            'S81 scoped functional dependencies, affected204 checks and HTTP02/native cleanup supplements',
            'original S65 repair02 and S69 causal replay provenance',
            'failed-attempt forensics and skip accounting', 'two independent same-hash critics']}
    print(json.dumps(result, indent=2, allow_nan=False))
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, KeyError, TypeError, ValueError, RuntimeError) as error:
        print(json.dumps({'verified_campaign_artifacts': False, 'formal_acceptance': False,
                          'error_type': type(error).__name__, 'error': str(error)}))
        raise SystemExit(2)
