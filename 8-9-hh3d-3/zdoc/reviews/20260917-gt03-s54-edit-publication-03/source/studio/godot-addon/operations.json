{
  "catalog_version": "gt03-godot-5",
  "protocol_version": "1.0",
  "schema_version": "hh-studio-0.1",
  "scope": "godot.fixture",
  "scene_path": "scenes/fixture.tscn",
  "script_path": "scripts/fixture_actor.gd",
  "root_stable_id": "root",
  "metadata_key": "hh_studio_id",
  "managed_edit_policy": {
    "scope": "fresh_host_owned_fixture",
    "effect_scope": "editor_session",
    "checkpoint": "protected scene and observation blobs before native edit",
    "receipt": "exact durable response with original session and revision",
    "history": "same native editor UndoRedo history until explicit save or script replacement",
    "files_saved": false,
    "live_state_durable": false,
    "editor_effect_slots": 16,
    "slots_per_edit": 2,
    "slots_reserved_for_save": 2
  },
  "managed_save_policy": {
    "scope": "fresh_host_owned_fixture",
    "changed_input": "scenes/fixture.tscn",
    "unchanged_inputs": "all ten other complete-profile input files",
    "history": "checkpoint_then_reload_boundary",
    "old_generation_undo_redo": "reject",
    "artist_project_save": false
  },
  "managed_script_policy": {
    "profile": "hh-godot-declarative-1",
    "path": "scripts/fixture_actor.gd",
    "publication": "one complete bundle with the captured dirty scene",
    "activation": "retire old owned editor then open selected generation",
    "history": "checkpoint and fresh editor generation",
    "general_gdscript": false,
    "artist_project_write": false,
    "preview_max_input_lines": 512,
    "preview_max_display_lines": 256,
    "preview_max_display_utf8_bytes": 32768
  },
  "revision": "sha256:<64 lowercase hex>; semantic scene state; generation is reload epoch",
  "project_revision": "sha256:<64 lowercase hex>; complete selected scene+script bundle; distinct from scene revision and reload generation",
  "revision_contract": {
    "expected_revision": "envelope semantic scene revision, guarded by host and main-thread scene engine",
    "expected_project_revision": "required in all non-inspect payloads and nested preview mutation payloads; trusted host checks then strips from engine projection",
    "inspect_result": {"scene_revision": "trusted complete semantic scene observation", "project_revision": "trusted selected scene+script bundle observation"},
    "runtime_inspect_integration": "managed owner binds live editor observation to selected bundle; native scene snapshot alone contains no bundle revision"
  },
  "limits": {
    "max_nodes": 64,
    "max_depth": 16,
    "max_name_chars": 48,
    "max_id_chars": 64,
    "max_inspect_nodes": 64,
    "max_script_utf8_bytes": 16384,
    "max_payload_bytes": 65536,
    "max_projection_bytes": 65536,
    "max_deadline_ms": 30000,
    "max_save_deadline_ms": 90000
  },
  "node_types": ["Node3D", "MeshInstance3D"],
  "resource_types": ["BoxMesh"],
  "preview_operations": ["scene.node.create", "scene.node.update", "scene.node.remove", "script_text.replace"],
  "properties": {
    "name": {"pattern": "[A-Za-z][A-Za-z0-9_]{0,47}"},
    "position": {"length": 3, "minimum": -10000, "maximum": 10000},
    "rotation_degrees": {"length": 3, "minimum": -360, "maximum": 360},
    "scale": {"length": 3, "minimum": 0.001, "maximum": 1000},
    "box_size": {"length": 3, "minimum": 0.001, "maximum": 1000}
  },
  "operations": {
    "scene.inspect": {"kind": "inspect", "target": "root", "required": ["expected_generation", "offset", "limit"], "optional": [], "recovery": "none", "implemented": false, "runtime_enabled": false},
    "scene.node.create": {"kind": "mutation", "target": "parent", "required": ["expected_generation", "expected_project_revision", "stable_id", "node_type", "name", "position", "rotation_degrees", "scale"], "optional": ["box_size"], "recovery": "undo_or_checkpoint", "implemented": false, "runtime_enabled": false},
    "scene.node.update": {"kind": "mutation", "target": "node", "required": ["expected_generation", "expected_project_revision", "changes"], "optional": [], "recovery": "undo_or_checkpoint", "implemented": false, "runtime_enabled": false},
    "scene.node.remove": {"kind": "mutation", "target": "node", "required": ["expected_generation", "expected_project_revision"], "optional": [], "recovery": "checkpoint_then_undo", "implemented": false, "runtime_enabled": false},
    "script_text.replace": {"kind": "mutation", "target": "script", "required": ["expected_generation", "expected_project_revision", "expected_sha256", "text"], "optional": [], "recovery": "checkpoint_and_staged_parse_publish", "implemented": false, "runtime_enabled": false},
    "scene.undo": {"kind": "mutation", "target": "root", "required": ["expected_generation", "expected_project_revision", "steps"], "optional": [], "recovery": "revision_checked_history", "implemented": false, "runtime_enabled": false},
    "scene.redo": {"kind": "mutation", "target": "root", "required": ["expected_generation", "expected_project_revision", "steps"], "optional": [], "recovery": "revision_checked_history", "implemented": false, "runtime_enabled": false},
    "scene.preview": {"kind": "preview", "target": "root", "required": ["expected_generation", "expected_project_revision", "operation", "target", "payload"], "optional": [], "recovery": "none", "implemented": false, "runtime_enabled": false},
    "scene.save": {"kind": "publication", "target": "root", "required": ["expected_generation", "expected_project_revision", "expected_files"], "optional": [], "recovery": "checkpoint_and_journaled_atomic_release", "implemented": false, "runtime_enabled": false}
  }
}
