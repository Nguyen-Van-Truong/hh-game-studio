; Fixed isolated GT05 fixture. The coordinator supplies validated input bytes.
config_version=5

[application]
config/name="HH GT05 Original Asset Fixture"
run/main_scene="res://authored.tscn"

[display]
window/size/viewport_width=640
window/size/viewport_height=640

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.06, 0.08, 0.12, 1)

[debug]
gdscript/warnings/untyped_declaration=1

