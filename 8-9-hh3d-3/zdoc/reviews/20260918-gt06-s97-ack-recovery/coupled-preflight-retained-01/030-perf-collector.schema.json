        "vsync_mode",
        "max_fps",
        "physics_hz",
        "time_scale",
        "build_mode",
        "fixed_fps",
        "delta_smoothing"
      ],
      "additionalProperties": false
    },
    "clock": {
      "type": "object",
      "properties": {
        "started_utc_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ended_utc_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtime_clock": {
          "const": "Godot.Time.get_ticks_usec",
          "type": "string"
        },
        "host_clock": {
          "const": "host.monotonic_ns_div_1000",
          "type": "string"
        },
        "runtime_start_mono_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "runtime_end_mono_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "host_start_mono_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "host_end_mono_us": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "started_utc_ms",
        "ended_utc_ms",
        "runtime_clock",
        "host_clock",
        "runtime_start_mono_us",
        "runtime_end_mono_us",
        "host_start_mono_us",
        "host_end_mono_us"
      ],
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "properties": {
        "metric": {
          "const": "runtime_frame_boundary_interval",
          "type": "string"
        },
        "hook": {
          "type": "string",
          "enum": [
            "frame_post_draw",
            "process_frame"
          ]
