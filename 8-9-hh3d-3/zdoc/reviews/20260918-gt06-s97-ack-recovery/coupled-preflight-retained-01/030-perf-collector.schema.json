{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hh-studio:perf-collector:1.0.0",
  "title": "HH Studio runtime frame collector v1",
  "description": "Closed local artifact; not a shared command envelope. Structural plus semantic validation is implemented in host/replay/perf.py. Timing is runtime frame-boundary elapsed time, not GPU presentation latency. Raw SHA-256 fields have separate documented hash domains.",
  "type": "object",
  "properties": {
    "schema_id": {
      "const": "hh-studio.perf-collector",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "artifact_kind": {
      "const": "runtime_frame_capture",
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "command_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "runtime_instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "input_hz": {
          "const": 60,
          "type": "integer"
        },
        "source_closure_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "runtime_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "toolchain_lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "trace_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "profile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        },
        "collector_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "run_id",
        "command_id",
        "project_id",
        "runtime_instance_id",
        "seed",
        "input_hz",
        "source_closure_sha256",
        "runtime_snapshot_sha256",
        "toolchain_lock_sha256",
        "trace_sha256",
        "profile_sha256",
        "collector_sha256"
      ],
      "additionalProperties": false
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "process_start": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?:windows:[1-9][0-9]{0,19}|linux:[0-9a-f-]{36}:[1-9][0-9]{0,19})$"
