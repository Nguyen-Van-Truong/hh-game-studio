        "max_frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "max_rss_samples": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12000
        },
        "max_duration_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "counter_interval_frames": {
          "const": 1,
          "type": "integer"
        },
        "rss_interval_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000
