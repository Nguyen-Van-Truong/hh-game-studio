; Engine configuration file.
; Addon host for hh_agent (plugin lands in R2). Config only.

config_version=5

[application]

config/name="HH Plugin Host"
config/description="Empty-ish Godot 4.7 addon host. Do not add hh_agent here until R2."
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[rendering]

renderer/rendering_method="forward_plus"
