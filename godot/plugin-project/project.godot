; Engine configuration file.
; Addon host for hh_agent (R2-WP3). Enable this plugin only in this project.

config_version=5

[application]

config/name="HH Plugin Host"
config/description="Godot 4.7 addon host for hh_agent. Do not copy vendor MCP addons here."
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

HhReloadDriver="*res://hh_reload_driver.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[editor_plugins]

enabled=PackedStringArray("res://addons/hh_agent/plugin.cfg")

[rendering]

renderer/rendering_method="forward_plus"
