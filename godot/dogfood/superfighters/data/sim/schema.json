    "item_ammo_reload": "RL-ITEM-AMMO-RELOAD assumption, not observed",
    "balance_chaos": "RL-MODE-CHAOS assumption, not observed",
    "balance_crit": "RL-BAL-CRIT assumption, not observed",
    "balance_knock": "RL-BAL-KNOCK-JITTER assumption, not observed",
    "balance_spread": "RL-BAL-SPREAD-RNG assumption, not observed",
    "balance_cap": "RL-BAL-CAP assumption, not observed",
    "balance_stamina": "RL-BAL-STAMINA assumption, not observed",
    "world_schema": "RL-WORLD-SCHEMA assumption, not observed",
    "world_layers": "RL-WORLD-LAYERS assumption, not observed",
    "world_own": "RL-WORLD-OWN assumption, not observed",
    "prop_static": "RL-PROP-STATIC assumption, not observed",
    "prop_dynamic": "RL-PROP-DYNAMIC assumption, shove/throw this WP",
    "prop_oneway": "RL-PROP-ONEWAY assumption, not observed",
    "prop_break": "RL-PROP-BREAK assumption; glass/wood destroy this WP",
    "prop_pickup": "RL-PROP-PICKUP assumption, world marker not roster",
    "prop_expl": "RL-PROP-EXPL assumption; chain/fire/hang this WP",
    "nade_prop": "RL-NADE-PROP deferred VF4, glass/wood stay",
    "world_door": "RL-WORLD-DOOR assumption, not observed",
    "world_lift": "RL-WORLD-LIFT assumption, not observed",
    "world_board": "RL-WORLD-BOARD assumption, not observed",
    "world_trigger": "RL-WORLD-TRIGGER assumption, not observed"
