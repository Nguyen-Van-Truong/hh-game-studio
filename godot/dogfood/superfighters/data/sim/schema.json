{
  "schema": "vf.sim.v1",
  "schema_version": 1,
  "title": "Vault Fighters",
  "tick_hz": 60,
  "tick_dt": 0.016666666666666666,
  "epsilon": 0.001,
  "hash_scale": 1000,
  "max_catchup_ticks": 8,
  "y8_tick_rate_claimed": false,
  "ledger_clock": "RL-SIM-FIXED-60",
  "input_frame": {
    "id": "vf.sim.input_frame.v1",
    "fields": ["schema_version", "tick", "slot", "held", "pressed", "released", "move_x", "move_y"],
    "allowed_actions": ["left", "right", "up", "down", "jump", "crouch", "melee", "fire", "grenade", "roll", "dive", "kick"],
    "reserved_not_shipped": ["ledge"]
  },
  "snapshot": {
    "id": "vf.sim.snapshot.v1",
    "mutate": false
  },
  "trace": {
    "id": "vf.sim.trace.v1",
    "ledger_id": "vf.sim.event_ledger.v1",
    "official_forbids": ["teleport", "force_kill"],
    "snapshot_every_default": 15
  },
  "runtime": {
    "schema": "vf.runtime.v1",
    "path": "res://data/runtime/schema.json",
    "bridge": "res://data/runtime/bridge.json"
  },
  "honesty": {
    "hold_to_aim": "RL-CTRL-HOLD-AIM assumption, not observed",
    "roll": "RL-MOVE-ROLL assumption, not observed",
    "sprint": "RL-MOVE-SPRINT assumption, not observed",
    "roll_dive": "RL-MOVE-ROLL-DIVE Y8 observation unavailable; product dive/kick are assumption",
    "dive": "RL-MOVE-DIVE assumption, not observed",
    "kick": "RL-MOVE-JUMP-KICK assumption, not observed",
    "fall": "RL-MOVE-FALL assumption, not observed",
    "ladder": "RL-MOVE-LADDER assumption, not observed",
    "ledge": "RL-MOVE-LEDGE assumption, not observed; InputFrame action ledge stays reserved",
    "drop": "RL-MOVE-DROP assumption, not observed",
    "jump_crouch": "RL-MOVE-JUMP-CROUCH assumption",
    "loco_base": "RL-MOVE-LOCO-BASE assumption",
    "camera": "RL-CAM-ARENA assumption, not live-observed",
    "map_geometry": "RL-MAP-LANDMARKS assumption, not live-observed",
    "melee_phases": "RL-HIT-PHASES assumption, not observed",
    "hitbox": "RL-HIT-BOX assumption, not observed",
    "friendly_fire": "RL-HIT-FF assumption, not observed",
    "match_machine": "RL-MATCH-MACHINE assumption, not observed",
    "match_teams": "RL-MATCH-TEAMS assumption, not observed",
    "match_last": "RL-MATCH-LAST assumption, last standing, not observed",
    "match_seed": "RL-MATCH-SEED assumption, 7 + stage * 13",
    "match_timer": "RL-MATCH-TIMER assumption, not observed; default off",
    "match_countdown": "RL-MATCH-COUNTDOWN assumption, not observed",
    "vs_flow": "RL-VS-FLOW assumption, not observed",
    "vs_ready": "RL-VS-READY assumption, not observed",
    "vs_isolate": "RL-VS-ISOLATE assumption, not observed",
    "vs_rematch": "RL-VS-REMATCH assumption, not observed",
    "vs_first_run": "RL-VS-FIRST-RUN assumption, product UX target",
    "stage_order": "RL-STAGE-ORDER approximation, not observed Y8 order",
    "stage_progress": "RL-STAGE-PROGRESS assumption, win advances catalog map",
    "stage_save": "RL-STAGE-SAVE assumption, atomic user:// progress",
    "stage_reward": "RL-STAGE-REWARD assumption, first-win score/unlock hash",
    "stage_tier": "RL-STAGE-TIER approximation, bot-count tiers not Y8",
    "survival_loop": "RL-SURVIVAL-LOOP approximation, endless wave/score, not observed Y8",
    "survival_wave": "RL-SURVIVAL-WAVE approximation, escalating bot roster, not observed",
