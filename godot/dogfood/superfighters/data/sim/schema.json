    "hitstop": "RL-HIT-HITSTOP assumption, presentation only, clock still advances",
    "aim_dirs": "RL-AIM-DIRS assumption, not observed",
    "fire_semi": "RL-FIRE-SEMI assumption, not observed",
    "fire_auto": "RL-FIRE-AUTO assumption, not observed",
    "fire_ammo": "RL-FIRE-AMMO assumption, not observed",
    "fire_muzzle": "RL-FIRE-MUZZLE assumption, not observed",
    "fire_recoil": "RL-FIRE-RECOIL assumption, not observed",
    "fire_ballistic": "RL-FIRE-BALLISTIC assumption, ballistic not hitscan",
