; Empty-ish Godot 4.7 fixture for R1-WP4 stock-only vertical slice.
; Scene/player/input are created by addons/hh_stock_poc (EditorPlugin), not pre-authored.

config_version=5

[application]

config/name="HH Stock POC"
config/description="R1-WP4 disposable stock-only POC. Not hh_agent. Not MCP."
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

HHStockPocRuntime="*res://addons/hh_stock_poc/runtime.gd"

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/inferred_declaration=1

[editor_plugins]

enabled=PackedStringArray("res://addons/hh_stock_poc/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="forward_plus"
